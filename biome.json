{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "scripts/**/*.ts",
      "web/**/*.ts",
      "vite.config.ts",
      "!scripts/vendor/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "globals": [
      "document",
      "window"
    ]
  },
  "overrides": [
    {
      "includes": [
        "scripts/**/*.ts",
        "vite.config.ts"
      ],
      "javascript": {
        "globals": [
          "process"
        ]
      }
    }
  ]
}
