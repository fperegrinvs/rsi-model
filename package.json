{
  "name": "rsi-model-publication",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "bun": "1.3.14",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build:manuscript": "bun scripts/build-manuscript.ts",
    "build:site": "bun scripts/build-site.ts",
    "generate:baseline": "uv run --locked rsi-run-baseline --output-dir outputs",
    "generate:deep": "uv run --locked rsi-run-deep --output-dir outputs",
    "generate:integrated": "uv run --locked rsi-run-integrated --project-root . --output-dir outputs/integrated",
    "generate:part2": "uv run --locked rsi-run-part2 --output-dir outputs",
    "check:dependencies": "uv run --locked rsi-check-dependencies --project-root .",
    "check:notation": "uv run --locked rsi-check-notation --project-root .",
    "check:figures": "bun scripts/check-figures.ts",
    "check:tables": "bun scripts/tables.ts",
    "check:table-rendering": "bun scripts/check-tables.ts",
    "check:table-layout": "bun scripts/check-table-layout.ts",
    "check:figure-layout": "bun scripts/check-figure-layout.ts",
    "check:artifact-viewer": "bun scripts/check-artifact-viewer.ts",
    "check:equation-explanations": "bun scripts/check-equation-explanations.ts",
    "check:propositions": "bun scripts/check-propositions.ts",
    "check:font": "uv run --locked rsi-check-math-font --project-root .",
    "check:math-layout": "bun scripts/check-math-layout.ts",
    "capture:math-crops": "bun scripts/capture-math-reference-crops.ts",
    "check:prose": "uv run --locked rsi-check-prose --project-root .",
    "check:scenario-policy": "bun scripts/check-scenario-policy.ts",
    "check:readability": "bun scripts/check-readability.ts",
    "check:footnotes": "bun scripts/check-footnotes.ts",
    "check:site": "bun scripts/check-site.ts",
    "check:accessibility": "bun scripts/check-accessibility.ts",
    "check:external-links": "uv run --locked rsi-check-external-links --manuscript docs/Recursive_Industrial_Intelligence_r4.0.md",
    "check:ai-rnd-evidence": "uv run --locked python -m rsimodel.ai_rnd_evidence",
    "check:ai-rnd-source-refresh": "uv run --locked python -m rsimodel.ai_rnd_evidence --source-refresh",
    "check:actions": "bun --bun eslint .github/workflows --no-warn-ignored",
    "check:typescript": "bun --bun tsc --noEmit && biome check --files-ignore-unknown=true scripts web vite.config.ts",
    "format:typescript": "biome check --write --files-ignore-unknown=true scripts web vite.config.ts",
    "check:markdown": "bun --bun markdownlint-cli2",
    "check:yaml": "uv run --locked yamllint .github params",
    "test:typescript": "bun test tests/typescript",
    "quality:python": "uv lock --check && uv run --locked ruff check . && uv run --locked ruff format --check . && uv run --locked pyright",
    "test": "uv run --locked pytest -q",
    "test:coverage": "uv run --locked pytest -q --cov --cov-report=term-missing --cov-report=xml:outputs/quality/coverage.xml --cov-report=json && uv run --locked rsi-check-coverage",
    "check:package": "uv run --locked rsi-check-package --project-root .",
    "audit": "uv run --locked pip-audit",
    "sbom": "uv run --locked cyclonedx-py environment --pyproject pyproject.toml --output-reproducible --of JSON -o outputs/quality/sbom.cdx.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.62.0",
    "@types/bun": "1.3.14",
    "bun": "1.3.14",
    "csv-parse": "7.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-actionlint": "1.0.4",
    "markdownlint-cli2": "0.23.2",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "yaml-eslint-parser": "2.1.0"
  }
}
